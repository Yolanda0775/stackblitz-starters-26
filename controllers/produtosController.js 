const { lerBanco, salvarBanco } = require('../dados/produtosRepositorio');

async function listar(req, res) {
  try {
    const banco = await lerBanco();
    res.json(banco.produtos);
  } catch (erro) {
    res.status(500).json({ erro: 'Erro ao listar produtos' });
  }
}

async function buscarPorId(req, res) {
  try {
    const banco = await lerBanco();
    const id = Number(req.params.id);

    if (isNaN(id)) {
      return res.status(400).json({ erro: 'ID inválido' });
    }

    const produto = banco.produtos.find(p => p.id === id);

    if (!produto) {
      return res.status(404).json({ erro: 'Produto não encontrado' });
    }

    res.json(produto);
  } catch (erro) {
    res.status(500).json({ erro: 'Erro ao buscar produto' });
  }
}

async function criar(req, res) {
  try {
    const { nome, preco } = req.body;

    if (!nome || nome.trim() === '') {
      return res.status(400).json({ erro: 'Nome é obrigatório' });
    }

    const precoNumero = Number(preco);
    if (preco === undefined || isNaN(precoNumero) || precoNumero <= 0) {
      return res.status(400).json({ erro: 'Preço deve ser um número válido e maior que zero' });
    }

    const banco = await lerBanco();
    const novoProduto = {
      id: banco.proximoId,
      nome: nome.trim(),
      preco: precoNumero
    };

    banco.produtos.push(novoProduto);
    banco.proximoId++;

    await salvarBanco(banco);
    res.status(201).json(novoProduto);
  } catch (erro) {
    res.status(500).json({ erro: 'Erro ao criar produto' });
  }
}

async function atualizar(req, res) {
  try {
    const banco = await lerBanco();
    const id = Number(req.params.id);

    if (isNaN(id)) {
      return res.status(400).json({ erro: 'ID inválido' });
    }

    const indice = banco.produtos.findIndex(p => p.id === id);
    if (indice === -1) {
      return res.status(404).json({ erro: 'Produto não encontrado' });
    }

    const produto = banco.produtos[indice];
    const { nome, preco } = req.body;

    if (nome !== undefined) {
      const nomeTratado = nome.trim();
      if (nomeTratado === '') {
        return res.status(400).json({ erro: 'Nome não pode ser vazio' });
      }
      produto.nome = nomeTratado;
    }

    if (preco !== undefined) {
      const precoNumero = Number(preco);
      if (isNaN(precoNumero) || precoNumero <= 0) {
        return res.status(400).json({ erro: 'Preço deve ser um número válido e maior que zero' });
      }
      produto.preco = precoNumero;
    }

    await salvarBanco(banco);
    res.json(produto);
  } catch (erro) {
    res.status(500).json({ erro: 'Erro ao atualizar produto' });
  }
}

async function remover(req, res) {
  try {
    const banco = await lerBanco();
    const id = Number(req.params.id);

    if (isNaN(id)) {
      return res.status(400).json({ erro: 'ID inválido' });
    }

    const indice = banco.produtos.findIndex(p => p.id === id);
    if (indice === -1) {
      return res.status(404).json({ erro: 'Produto não encontrado' });
    }

    banco.produtos.splice(indice, 1);
    await salvarBanco(banco);
    res.status(204).send();
  } catch (erro) {
    res.status(500).json({ erro: 'Erro ao remover produto' });
  }
}

module.exports = { listar, buscarPorId, criar, atualizar, remover };